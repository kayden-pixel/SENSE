HOST=127.0.0.1
NODE_ENV=development
PORT=8787
DATABASE_PATH=./data/sense.sqlite
MEDIA_PATH=./data/media
# Server-only credentials. Use your own LiveKit server; no AI provider keys required.
LIVEKIT_URL=wss://voice.example.org
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Stable random 32+ byte secret for rotating nearby identifiers.
RADAR_SECRET=
# Development defaults only. Production uses NODE_ENV=production and absolute
# DATABASE_PATH / MEDIA_PATH on persistent storage (see render.yaml).
# HTTPS reverse proxy is mandatory for public access.
TRUST_PROXY=false
# Optional server-only prepared owner record; never include it in Android builds.
# Generate with: node tools/prepare-owner.mjs /absolute/private/directory owner-username
OWNER_ACCOUNT_FILE=
